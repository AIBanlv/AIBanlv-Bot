{
  "name": "control-windows",
  "private": true,
  "type": "module",
  "version": "0.2.8",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "setup": "npm run setup:deps && npm run runtime:prepare",
    "setup:deps": "node demos/web-desktop-pet/scripts/check-source-idle.mjs && npm ci --prefix android-native/renderer/tools/ali-native-shell-ui && node demos/web-desktop-pet/scripts/check-source-idle.mjs && npm ci --prefix demos/web-desktop-pet && node demos/web-desktop-pet/node_modules/electron/install.js",
    "runtime:prepare": "node demos/web-desktop-pet/scripts/setup-runtime.mjs",
    "runtime:package": "node demos/web-desktop-pet/scripts/package-source-runtime.mjs",
    "start": "npm --prefix demos/web-desktop-pet run device",
    "start:web": "npm --prefix demos/web-desktop-pet start",
    "test": "npm --prefix demos/web-desktop-pet test",
    "test:device": "npm --prefix demos/web-desktop-pet run device:test",
    "package:device": "npm --prefix demos/web-desktop-pet run device:package",
    "installer:device": "npm --prefix demos/web-desktop-pet run device:installer",
    "package:text": "node demos/web-desktop-pet/electron/text-package.mjs",
    "mac:prepare": "node demos/web-desktop-pet/scripts/prepare-mac.mjs",
    "mac:start": "npm start",
    "mac:benchmark": "node demos/web-desktop-pet/scripts/benchmark-mac.mjs",
    "mac:package": "npm run mac:prepare && node demos/web-desktop-pet/electron/device-package.mjs --platform=darwin",
    "mac:package:x64": "npm run mac:prepare -- --arch=x64 && node demos/web-desktop-pet/electron/device-package.mjs --platform=darwin --arch=x64",
    "mac:package:arm64": "npm run mac:prepare -- --arch=arm64 && node demos/web-desktop-pet/electron/device-package.mjs --platform=darwin --arch=arm64",
    "windows:package": "node demos/web-desktop-pet/electron/device-package.mjs --platform=win32 --arch=x64",
    "windows:installer": "npm run installer:device"
  },
  "dependencies": {
    "@dcloudio/uni-ui": "1.5.12"
  }
}
