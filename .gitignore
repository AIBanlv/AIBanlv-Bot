# Local settings, credentials, device identity, and private avatar caches.
.env
.env.*
*.local.*
*.pem
*.key
*.jks
*.p12
device-identity.json
display-preferences.json
display-preferences.json.tmp
avatars-*/

# Assistant workspace notes and ad-hoc debugging scratch kept out of the product.
.workbuddy/
/tasks/
/_*.py
/_*.png
/desktop-shot.*
/desktop-thumb.*

